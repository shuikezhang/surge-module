#!name=菜鸟 App 深度去广告
#!desc=菜鸟 8.11.910 深度净化：拦截第三方广告，并改写菜鸟页面响应以移除“我的”热门活动和首页推广。首次使用须开启 MITM，并建议卸载重装菜鸟。
#!author=Minis
#!system=ios

[Rule]
# 腾讯优量汇 / GDT
DOMAIN,mi.gdt.qq.com,REJECT
DOMAIN,v2mi.gdt.qq.com,REJECT
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN,sdkquic.e.qq.com,REJECT
DOMAIN,ipv4.gdt.qq.com,REJECT
DOMAIN,win.gdt.qq.com,REJECT
DOMAIN,v.gdt.qq.com,REJECT
DOMAIN,v3.gdt.qq.com,REJECT
DOMAIN,c3.gdt.qq.com,REJECT
DOMAIN,t.gdt.qq.com,REJECT
DOMAIN,pgdt.ugdtimg.com,REJECT
DOMAIN,adsmind.ugdtimg.com,REJECT

# 字节穿山甲 / Pangle
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT
DOMAIN,log-api.pangolin-sdk-toutiao-b.com,REJECT
DOMAIN,toblog.ctobsnssdk.com,REJECT
DOMAIN,tnc3-alisc1.zijieapi.com,REJECT
DOMAIN,sf3-fe-tos.pglstatp-toutiao.com,REJECT
DOMAIN,sf6-fe-tos.pglstatp-toutiao.com,REJECT
DOMAIN,v5-ex-be-pack.pglstatp-toutiao.com,REJECT

# 快手、1RTB、Ubix、Tanx 与广告监测
DOMAIN,p66-ad.adkwai.com,REJECT
DOMAIN,v66-ad.ndcjl.com,REJECT
DOMAIN,sdk.1rtb.net,REJECT
DOMAIN,adx-cfg-u1.ubixioe.com,REJECT
DOMAIN,adx-data-u1.ubixioe.com,REJECT
DOMAIN,entry-su1.ubixioe.com,REJECT
DOMAIN,df.tanx.com,REJECT
DOMAIN,bdlog.tanx.com,REJECT
DOMAIN,rdstat.tanx.com,REJECT
DOMAIN,ipm.atm.youku.com,REJECT
DOMAIN,admonitor-feedback.cn-hangzhou.log.aliyuncs.com,REJECT
DOMAIN,nbnest-admonitor.cainiao.com,REJECT

[Script]
# 菜鸟原生广告与商品流：修改真实响应为已加载的空列表，避免留下加载骨架。
cainiao-native-ads = type=http-response, pattern=^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.(?:guoguo\.nbnetflow\.ads\.|nbcps\.presentation\.fetch\.cn), script-path=https://raw.githubusercontent.com/shuikezhang/surge-module/minis/cainiao-adblock-20260918/cainiao-feed-clean.js, requires-body=true, max-size=0

# 菜鸟会通过 AMDC 将接口调度到裸 IP；先阻断调度，才能让 MITM/响应脚本命中域名请求。
cainiao-amdc = type=http-response, pattern=^http:\/\/(?:amdc\.m\.taobao\.com|59\.82\.(?:14\.1|34\.(?:147|148)))\/amdc\/mobileDispatch, script-path=https://raw.githubusercontent.com/shuikezhang/surge-module/minis/cainiao-adblock-20260918/cainiao-amdc.js, requires-body=true, max-size=0
# “我的”页面：钱包、热门活动、会员及运营卡片
cainiao-my-page = type=http-response, pattern=^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine(?:\.page\.fetch)?, script-path=https://raw.githubusercontent.com/shuikezhang/surge-module/minis/cainiao-adblock-20260918/cainiao-clean.js, requires-body=true, max-size=0
# 首页运营推广
cainiao-home-merge = type=http-response, pattern=^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.homepage\.merge\.get\.cn, script-path=https://raw.githubusercontent.com/shuikezhang/surge-module/minis/cainiao-adblock-20260918/cainiao-clean.js, requires-body=true, max-size=0
cainiao-home-protocol = type=http-response, pattern=^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.protocol\.homepage\.get\.cn, script-path=https://raw.githubusercontent.com/shuikezhang/surge-module/minis/cainiao-adblock-20260918/cainiao-clean.js, requires-body=true, max-size=0
cainiao-ad-keyword = type=http-response, pattern=^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.adkeyword, script-path=https://raw.githubusercontent.com/shuikezhang/surge-module/minis/cainiao-adblock-20260918/cainiao-clean.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% *.cainiao.com
